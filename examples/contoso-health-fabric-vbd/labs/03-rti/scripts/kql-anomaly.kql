// kql-anomaly.kql — 5-minute windowed anomaly detection per provider.
// Verified against Microsoft Learn: https://learn.microsoft.com/kusto/query/series-decompose-anomalies-function

let baseline_days = 30;
let window = 5m;
claims_raw
| where claim_time > ago(baseline_days * 1d)
| summarize claim_count = count() by provider_id, bin(claim_time, window)
| order by provider_id asc, claim_time asc
| make-series count=sum(claim_count) default=0 on claim_time step window by provider_id
| extend anomalies = series_decompose_anomalies(count, 3.0)
| mv-expand claim_time to typeof(datetime), count to typeof(long), anomalies to typeof(int)
| where anomalies != 0
| project provider_id, claim_time, count, anomalies
